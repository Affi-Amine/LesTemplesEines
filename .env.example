NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

RESEND_API_KEY=
EMAIL_FROM="Les Temples <onboarding@resend.dev>"
APP_URL="http://localhost:3000"
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

NOTIFICATIONS_ADMIN_EMAIL=

# Vercel Cron sends it as `Authorization: Bearer <value>` (/api/cron/*).
CRON_SECRET=

# Planity / Treatwell sync (/api/cron/platform-sync, lib/sync, docs/platform-sync.md).
# Managed from the back office (Administration > Synchronisation); these are fallbacks.
# Planity login used when none was saved in the back office.
PLANITY_USERNAME=
PLANITY_PASSWORD=
# Treatwell cannot be logged in by the server: import a browser session in the
# back office or run `npm run sync:login -- treatwell`. Kept for reference only.
TREATWELL_USERNAME=
TREATWELL_PASSWORD=
# "live" lets the job write; anything else = dry run (report only). The back office cannot override it.
PLATFORM_SYNC_MODE=dry-run
# Days ahead to keep in sync (default 60).
PLATFORM_SYNC_DAYS=60
# Encrypts stored platform sessions and logins. Falls back to JWT_SECRET; changing it logs every platform out.
PLATFORM_SYNC_SECRET=
