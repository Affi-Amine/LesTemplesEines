NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

RESEND_API_KEY=
EMAIL_FROM="Les Temples <onboarding@resend.dev>"
APP_URL="http://localhost:3000"
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

NOTIFICATIONS_ADMIN_EMAIL=

# Vercel Cron sends it as `Authorization: Bearer <value>` (/api/cron/*).
CRON_SECRET=

# Planity / Treatwell sync (/api/cron/platform-sync, lib/sync).
PLANITY_USERNAME=
PLANITY_PASSWORD=
# Treatwell needs a one-off human login: npm run sync:login -- treatwell
TREATWELL_USERNAME=
TREATWELL_PASSWORD=
# "live" lets the job write; anything else = dry run (report only).
PLATFORM_SYNC_MODE=dry-run
# Days ahead to keep in sync (default 60).
PLATFORM_SYNC_DAYS=60
# Encrypts stored platform sessions. Falls back to JWT_SECRET.
PLATFORM_SYNC_SECRET=
